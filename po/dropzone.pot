#: data/io.github.dragonGR.Dropzone.metainfo.xml.in:9
msgid ""
"Dropzone is a GNOME application for fast, temporary file sharing over the "
"local network."
msgstr ""

#: data/io.github.dragonGR.Dropzone.metainfo.xml.in:12
msgid ""
"Select a file to start an ephemeral HTTP server and generate a "
"cryptographically random capability URL with a QR code. Any device on the "
"same local network can scan the QR code and download the file directly in a "
"web browser without installing additional software or creating accounts."
msgstr ""

#: data/io.github.dragonGR.Dropzone.metainfo.xml.in:15
msgid "Stopping sharing immediately stops the server and invalidates the link."
msgstr ""

#: data/io.github.dragonGR.Dropzone.metainfo.xml.in:23
msgid "Choose or drag files to share over the local network"
msgstr ""

#: data/io.github.dragonGR.Dropzone.metainfo.xml.in:27
msgid "Active sharing session with QR code and copyable LAN link"
msgstr ""

